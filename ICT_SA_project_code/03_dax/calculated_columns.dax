// Calculated column on JobPostings
MonthStart = DATE(YEAR(JobPostings[PostedDate]), MONTH(JobPostings[PostedDate]), 1)

// Power BI also auto-created hidden date tables (LocalDateTable_*) for PostedDate and MonthStart:
