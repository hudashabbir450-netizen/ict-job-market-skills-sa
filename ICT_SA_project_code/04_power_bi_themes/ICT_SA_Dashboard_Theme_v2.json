{
  "name": "ICT SA Dashboard v2",
  "dataColors": ["#2A9D8F", "#16213E", "#E8A33D", "#E4634B", "#6C7A96", "#8AA399", "#5B8DB8", "#C9A227", "#9B5E8A", "#3F6B63"],
  "background": "#FFFFFF",
  "foreground": "#151B33",
  "tableAccent": "#2A9D8F",
  "good": "#2A9D8F",
  "neutral": "#E8A33D",
  "bad": "#E4634B",
  "min": "#E6F4F1",
  "max": "#1E7F74",
  "minimum": "#E4634B",
  "center": "#F6E7C6",
  "maximum": "#2A9D8F",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#16213E" },
    "header":  { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#16213E" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 11, "color": "#4A5568" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#16213E" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DDE3EA" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    }
  }
}
